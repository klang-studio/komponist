<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template of komponist.app/Contents/Info.plist; scripts/bundle-macos.sh replaces @VERSION@. -->
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>io.github.klang-studio.komponist</string>
    <key>CFBundleName</key>
    <string>komponist</string>
    <key>CFBundleDisplayName</key>
    <string>komponist</string>
    <key>CFBundleExecutable</key>
    <string>komponist</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleIconFile</key>
    <string>komponist</string>
    <key>CFBundleShortVersionString</key>
    <string>@VERSION@</string>
    <key>CFBundleVersion</key>
    <string>@VERSION@</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleLocalizations</key>
    <array>
        <string>de</string>
        <string>en</string>
    </array>
    <key>LSMinimumSystemVersion</key>
    <string>14.4</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.music</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>
    <key>NSMicrophoneUsageDescription</key>
    <string>komponist needs microphone access to record audio tracks.</string>
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>io.github.klang-studio.komponist.project</string>
            <key>UTTypeDescription</key>
            <string>komponist project</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.json</string>
                <string>public.data</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>komponist</string>
                </array>
                <key>public.mime-type</key>
                <string>application/x-komponist-project</string>
            </dict>
        </dict>
    </array>
</dict>
</plist>
