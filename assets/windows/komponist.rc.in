// Resource script of komponist.exe: icon, version information and the application manifest. build.rs
// (crates/komponist-app) substitutes the four @…@ placeholders below and compiles the result with
// embed-resource (MSVC rc.exe). Only literal numbers, no windows.h, so rc.exe needs no include path.

// The lowest icon id is the one Explorer shows for the .exe and the taskbar uses.
1 ICON "@ICON@"
// CREATEPROCESS_MANIFEST_RESOURCE_ID (1), RT_MANIFEST (24).
1 24 "@MANIFEST@"

1 VERSIONINFO
FILEVERSION @VERSION_NUM@
PRODUCTVERSION @VERSION_NUM@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L // VOS_NT_WINDOWS32
FILETYPE 0x1L   // VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0" // US English, Unicode
        BEGIN
            VALUE "CompanyName", "klang-studio"
            VALUE "FileDescription", "komponist - MIDI DAW"
            VALUE "FileVersion", "@VERSION@"
            VALUE "InternalName", "komponist"
            VALUE "LegalCopyright", "GPL-3.0-or-later"
            VALUE "OriginalFilename", "komponist.exe"
            VALUE "ProductName", "komponist"
            VALUE "ProductVersion", "@VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04b0
    END
END
