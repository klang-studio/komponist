<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Application manifest of komponist.exe, embedded by crates/komponist-app/build.rs (ARCHITECTURE §8.8).
     The plugin bridge is the same executable (started with the bridge flag), so it carries this manifest too. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="io.github.klang-studio.komponist" version="1.0.0.0" processorArchitecture="amd64"/>
  <description>komponist</description>

  <!-- No elevation: komponist keeps its files in the user profile. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!-- Windows 10 and 11 share one id; the Windows 8.1 and 7 ids are left out on purpose (the Rust target needs 10). -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- Per-monitor v2 DPI awareness (evaluation §3.6): the egui window and the bridge-owned plugin frames scale
           per monitor; the older <dpiAware> value is the fallback of Windows 8.1 / early Windows 10. -->
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, PerMonitor</dpiAwareness>
      <!-- Paths longer than MAX_PATH (260) in project, plugin and sample folders (needs the LongPathsEnabled policy too). -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
      <!-- No activeCodePage: the manifest also applies to the bridge processes, and plugins there expect the
           system's ANSI code page as in every other host. komponist itself only uses the wide-character APIs. -->
    </windowsSettings>
  </application>
</assembly>
