## Shell: panel titles, resize edges and the empty dock bodies (`Screens.dc.html` shell markup, `ks-view.js` `dockView`).

# Arrangement panel title.
shell-arrangement = Arrangement

# Browser panel title and name of its collapsed rail.
shell-browser = Browser

# Inspector panel title and name of its collapsed rail.
shell-inspector = Inspector

# Accessible name of the browser's resize edge.
shell-browser-edge = Browser-Breite

# Accessible name of the inspector's resize edge.
shell-inspector-edge = Inspector-Breite

# Accessible name of the dock's resize edge.
shell-dock-edge = Dock-Höhe

# Empty editor tab, title (S02/S10 `isEmpty`).
shell-no-clip-open = Kein Clip geöffnet

# Empty editor tab, hint below the title.
shell-no-clip-hint = Doppelklick auf einen Clip öffnet ihn hier, als Piano Roll oder Step Sequencer.

# Devices tab without a selected track, title.
shell-no-track = Keine Spur ausgewählt

# Devices tab without a selected track, hint below the title.
shell-no-track-hint = Spur-Header anklicken, dann zeigt dieser Tab ihre Geräte-Kette.
