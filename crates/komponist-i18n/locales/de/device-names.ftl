## Names of the built-in devices (`komponist-builtin`, `Internal::name_in`). Brand names stay; generic ones translate.

# Name of the FM synthesizer (brand).
device-name-hexa = Hexa
device-description-hexa = FM-Synthesizer mit sechs Operatoren.

# Name of the virtual-analog synthesizer (brand).
device-name-volt = Volt
device-description-volt = Virtuell-analoger Synthesizer mit zwei Oszillatoren.

# Name of the wavetable synthesizer (brand).
device-name-surf = Surf
device-description-surf = Wavetable-Synthesizer mit zwei Oszillatoren.

# Name of the drum sampler.
