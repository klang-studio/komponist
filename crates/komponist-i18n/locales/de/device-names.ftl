# Name of the compressor (brand).
device-name-presse = Presse
device-description-presse = Kompressor mit Sidechain-Eingang.

# Name of the equalizer.
device-name-eq = EQ
device-description-eq = Parametrischer Equalizer zur Klangformung.

# Name of the delay.
device-name-delay = Delay
