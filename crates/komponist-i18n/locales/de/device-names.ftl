# Name of the reverb.
device-name-hall = Hall
device-description-hall = Raumklang für Instrumente und Audiosignale.

# Name of the limiter.
device-name-limiter = Limiter
device-description-limiter = Begrenzt Spitzenpegel.

# Name of the arpeggiator MIDI effect.
device-name-arpeggiator = Arpeggiator
