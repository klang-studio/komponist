## The file browser (`dialogs/file.rs`; komponist's own, the screens have none).

# Title when opening a project.
file-open-title = Projekt öffnen

# Title when saving a project.
file-save-title = Projekt speichern

# Title when choosing a plugin folder (S07 "+ Ordner").
file-folder-title = Plugin-Ordner hinzufügen

# Title when choosing a sample for a sampler pad.
file-sample-title = Sample laden

# Primary button when opening.
file-open = Öffnen

# Primary button when saving.
file-save = Speichern

# Primary button when saving over an existing file.
file-replace = Ersetzen

# Primary button when choosing a folder.
file-choose-folder = Ordner wählen

# Primary button when choosing a sample.
file-load = Laden

# Label of the folder field.
file-folder = Ordner

# Name of the "‹" button.
file-parent = Übergeordneter Ordner

# Label of the file name field when saving.
file-name = Dateiname

# Name of the list of files and folders.
file-list = Dateien

# Empty list when opening or saving.
file-no-projects = Keine Projekte in diesem Ordner

# Empty list when choosing a folder.
file-no-folders = Keine Unterordner

# Empty list when choosing a sample.
file-no-samples = Keine Samples in diesem Ordner

# A folder cannot be listed; `$path` is the folder, `$reason` the system's text.
file-unreadable = { $path } lässt sich nicht lesen: { $reason }

# The typed file name names a folder that does not exist; `$path` is the shortened path.
file-no-such-folder = Den Ordner { $path } gibt es nicht

# Saving would replace a file; `$file` is its name.
file-exists = „{ $file }“ gibt es schon. Ersetzen?

# The typed location does not exist.
file-no-such-path = { $path } gibt es nicht
