## Names the app gives to new content (`komponist_model::edits::DefaultNames`, step rows). Content once made, never retranslated.

# Base of a new MIDI track without instrument: „MIDI“, „MIDI 2“, …
default-name-track = MIDI

# Name of a new track with the Sampler.
default-name-drums = Drums

# Base of a new effect bus: „Bus 1“, „Bus 2“, …
default-name-bus = Bus

# Base of a new group: „Gruppe 1“, „Gruppe 2“, …
default-name-group = Gruppe

# Step row and pad of a new drum clip: the closed hi-hat (S03).
default-name-hat-closed = Hat zu

# Step row and pad of a new drum clip: the open hi-hat (S03).
default-name-hat-open = Hat offen
