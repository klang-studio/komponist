## The "Neue Spur" dialog (`dialogs/new_track.rs`; komponist's own, the screens have none).

# Title and accessible name of the dialog.
new-track-title = Neue Spur

# Row label and name of the track type control.
new-track-kind = Spurtyp

# Track type: MIDI track.
new-track-midi = MIDI

# Track type: effect bus.
new-track-bus = Bus

# Row label and name of the instrument list.
new-track-instrument = Instrument

# Name and hint of the instrument search field.
new-track-search = Instrument suchen

# First list entry: a track without instrument.
new-track-no-instrument = Kein Instrument

# Row label and name of the name field.
new-track-name = Name

# Row label and name of the count field.
new-track-count = Anzahl

# Primary button (Enter).
new-track-create = Anlegen

# Linked audio import and browsing (epic #8).
new-track-type-audio = Audio
new-track-input = Eingang
new-track-no-input = Kein Eingang
new-track-input-mono = Eingang { $n }
new-track-input-pair = Eingang { $a }+{ $b }
new-track-input-bus = Bus { $name }
