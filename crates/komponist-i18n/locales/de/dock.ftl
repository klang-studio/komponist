## Dock tab strip (`Screens.dc.html` `tab`, `dock`, `editorTabs`; `Layout.dc.html` `dockRules`).

# Accessible name of the tab list.
dock-tabs = Dock

# Editor tab without an open clip (`editorTabs('Kein Clip', …)`).
dock-no-clip = Kein Clip

# Devices tab.
dock-devices = Geräte

# Mixer tab.
dock-mixer = Mixer

# The "+" for later views (disabled in v0.1).
dock-more = Weitere Ansichten

# Maximise button, off.
dock-maximize = Maximieren

# Maximise button, on.
dock-maximized = Maximiert

# The caret while the dock is open.
dock-collapse = Dock einklappen

# The caret while the dock is collapsed.
dock-expand = Dock ausklappen

# Secondary text of the editor tab for MIDI clips.
dock-piano-roll = Piano Roll

# Secondary text of the editor tab for step clips.
dock-step-sequencer = Step Sequencer

# Title of the editor tab while recording (`editorTabs('● Aufnahme', …)`, S02). The tab draws the
# leading ● as a circle, the fonts lack it.
dock-recording = ● Aufnahme

# Secondary text of the editor tab while recording (S02).
dock-recording-kind = Piano Roll · live

# Tooltip of the maximise icon button while the dock is not maximised.
dock-maximize-tip = Dock maximieren

# Tooltip of the maximise icon button while the dock is maximised.
dock-restore-tip = Dock wiederherstellen

# Accessible name of a divider in a clip editor.
dock-section-height = Höhe · { $section }
