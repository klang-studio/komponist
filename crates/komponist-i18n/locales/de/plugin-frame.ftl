## The plugin frame window: header and body (`windows/plugin_frame/`; S05 `pluginView`, `card()`).

# S05 bypass button.
plugin-frame-bypass = Bypass

# S05 save preset button.
plugin-frame-save = Speichern

# S05 keep the frame above other windows.
plugin-frame-keep-on-top = Oben halten

# S05 name of the view switch.
plugin-frame-view = Ansicht

# S05 view segment: the plugin's own GUI.
plugin-frame-view-plugin = Plugin

# S05 view segment: the generic parameter grid.
plugin-frame-view-params = Parameter

# S05 name of the preset field.
plugin-frame-preset = Preset

# S05 name of the ‹ button.
plugin-frame-preset-prev = Voriges Preset

# S05 name of the › button.
plugin-frame-preset-next = Nächstes Preset

# S05 body of a device that is loading (`card()` `msg`).
plugin-frame-loading = Lädt …

# S05 second line of the loading body (`card()` `msg2`).
plugin-frame-loading-detail = Plugin wird gescannt und instanziiert.

# S05 button of a crashed device.
plugin-frame-reload = Neu laden

# S06 body of a missing plugin; `$name` is the plugin name.
plugin-frame-missing = { $name } fehlt

# Prototype `pw.guiT`: placeholder where no plugin window can be embedded; `$name` is the plugin name.
plugin-frame-gui-placeholder = Plugin-GUI · zeichnet { $name } selbst

# Second line of that placeholder (rule 1: the frame belongs to komponist).
plugin-frame-gui-placeholder-detail = Rahmen von komponist, Inhalt vom Plugin

# Status: the plugin's GUI cannot be opened; `$name` is the plugin name.
plugin-frame-gui-failed = { $name }: Plugin-GUI lässt sich nicht öffnen
