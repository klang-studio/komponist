## Key names of shortcut labels (`KeyChord::label`, HANDOFF §7; docs/I18N.md §6). Letters, digits, arrows and symbols stay in Rust.

# Modifier Ctrl: the shortcut modifier on Linux (macOS: key-command-mac).
key-ctrl = Strg

# Modifier Shift.
key-shift = Shift

# Modifier Alt.
key-alt = Alt

# Separator between the parts of a shortcut on Linux (German "Strg Shift E", English "Ctrl+Shift+E").
key-separator = { " " }

## macOS: glyphs in Apple's order (⌥ ⇧ ⌘), no separator (issue #47, owner decision 4).

# Modifier Command, the shortcut modifier on macOS.
key-command-mac = ⌘

# Modifier Shift on macOS.
key-shift-mac = ⇧

# Modifier Option (Alt) on macOS.
key-alt-mac = ⌥

# Separator between the parts of a shortcut on macOS ("⇧⌘E"): none.
key-separator-mac = { "" }

# Space bar.
key-space = Leertaste

# Tab key.
key-tab = Tab

# Enter key.
key-enter = Enter

# Escape key.
key-escape = Esc

# Delete key.
key-delete = Entf

# Backspace key.
key-backspace = Rücktaste

# Home key.
key-home = Pos1

# End key.
key-end = Ende
