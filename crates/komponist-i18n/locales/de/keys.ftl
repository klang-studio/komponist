## Key names of shortcut labels (`KeyChord::label`, HANDOFF §7; docs/I18N.md §6). Letters, digits, arrows and symbols stay in Rust.

# Modifier Ctrl.
key-ctrl = Strg

# Modifier Shift.
key-shift = Shift

# Modifier Alt.
key-alt = Alt

# Separator between the parts of a shortcut (German "Strg Shift E", English "Ctrl+Shift+E").
key-separator = { " " }

# Space bar.
key-space = Leertaste

# Tab key.
key-tab = Tab

# Enter key.
key-enter = Enter

# Escape key.
key-escape = Esc

# Delete key.
key-delete = Entf

# Backspace key.
key-backspace = Rücktaste

# Home key.
key-home = Pos1

# End key.
key-end = Ende
