## New projects (S10) and the unsaved-changes prompt (`dialogs/new_project.rs`).

# Name of an empty new project (S10); content once it exists, saved in the project.
new-project-default-name = Unbenannt

# Name of the template project (S09 "Aus Vorlage · Beat-Skizze"); also the hint on the start screen button.
new-project-template-name = Beat-Skizze

# Title of the prompt before the open project is replaced (komponist's own text).
new-project-unsaved-title = Änderungen speichern?

# Text of that prompt; `$name` is the project name.
new-project-unsaved-text = „{ $name }“ hat ungespeicherte Änderungen. Ohne Speichern gehen sie verloren.

# Primary button of the prompt (Enter).
new-project-save = Speichern

# Button of the prompt: continue without saving.
new-project-discard = Nicht speichern
