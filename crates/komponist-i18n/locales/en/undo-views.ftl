## Undo step labels the views send (WP #2). Same rules as `undo.ftl`: the id is stored in the document and resolved where a label is shown.

# Undo step: dragging the bottom edge of a track header.
undo-track-height = Track Height

# Undo step: switching several tracks' mute, solo or arm in one gesture.
undo-toggle-tracks = Toggle Tracks

# Undo step: a mixer volume fader.
undo-volume = Volume

# Undo step: a pan knob.
undo-pan = Pan

# Undo step: setting a note with the pencil.
undo-set-note = Set Note

# Undo step: adding an EQ band by clicking in the curve.
undo-add-band = Add Band

# Undo step: a step lane drag (velocity, probability, ratchet).
undo-lane = Lane

# Undo step: the probability of steps.
undo-probability = Probability

# Undo step: dragging over steps.
undo-steps = Steps

# Undo step: the ratchet of steps.
undo-ratchet = Ratchet

# Undo step: the swing of a pattern.
undo-swing = Swing

# Undo step: the length of a pattern.
undo-pattern-length = Pattern Length

# Audio playback mode, including opt-in Warp.
undo-clip-audio-mode = Change Audio Mode
