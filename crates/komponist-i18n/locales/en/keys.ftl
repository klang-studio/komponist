## Key names of shortcut labels (`KeyChord::label`, HANDOFF §7; docs/I18N.md §6). Letters, digits, arrows and symbols stay in Rust.

# Modifier Ctrl.
key-ctrl = Ctrl

# Modifier Shift.
key-shift = Shift

# Modifier Alt.
key-alt = Alt

# Separator between the parts of a shortcut (German "Strg Shift E", English "Ctrl+Shift+E").
key-separator = +

# Space bar.
key-space = Space

# Tab key.
key-tab = Tab

# Enter key.
key-enter = Enter

# Escape key.
key-escape = Esc

# Delete key.
key-delete = Del

# Backspace key.
key-backspace = Backspace

# Home key.
key-home = Home

# End key.
key-end = End
